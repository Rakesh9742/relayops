# SQLite is an explicit local preview. For the graph-backed app use falkordb.
MEMORY_BACKEND=sqlite
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6387
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
PORT=4177
HOST=127.0.0.1
# auto uses OpenAI if configured, then Anthropic, otherwise simulation.
# Set simulation to disable API calls even when keys are present.
MODEL_PROVIDER=auto
# Optional model explanations and conversation. Never use VITE_* for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional alternative provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Local demo login is deliberately restricted to loopback.
# Set DEMO_ACCESS_CODE before exposing a hosted demo; anyone with it can view both sample workspaces.
DEMO_ACCESS_CODE=
