# RelayOps runs on FalkorDB only. `docker compose up -d` starts it on 6387.
MEMORY_BACKEND=falkordb
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6387
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
PORT=4177
HOST=127.0.0.1
# auto uses OpenAI if configured, then Anthropic, otherwise a deterministic policy over the same graph tools.
MODEL_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Local login is restricted to loopback. Set DEMO_ACCESS_CODE before exposing on a network.
DEMO_ACCESS_CODE=
COOKIE_SECURE=false
